@model ReportsViewModel
@{
    ViewData["Title"] = "Báo cáo";
    var report = Model.Report;
    var section = Model.Section;
}
<p class="eyebrow mb-1">KHU VỰC QUẢN TRỊ</p>
<h1>Báo cáo và thống kê</h1>
@if (report is not null)
{
    var lowStock = report.Inventory.Count(book => book.Stock < book.Minimum);
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><div class="surface p-3">Doanh thu hôm nay <strong class="d-block fs-4">@report.RevenueToday.ToString("N0") ₫</strong></div></div>
        <div class="col-6 col-md-3"><div class="surface p-3">Đơn mới hôm nay <strong class="d-block fs-4">@report.NewOrdersToday</strong></div></div>
        <div class="col-6 col-md-3"><div class="surface p-3">Đơn chờ xác nhận <strong class="d-block fs-4">@report.PendingOrders</strong></div></div>
        <div class="col-6 col-md-3"><div class="surface p-3">Sách sắp hết <strong class="d-block fs-4">@lowStock</strong></div></div>
    </div>
}
<form asp-action="Index" method="get" class="surface p-3 row g-2 align-items-end mb-4">
    <div asp-validation-summary="All" class="col-12 text-danger" role="alert"></div>
    <label class="col-sm">Từ ngày<input class="form-control" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" required /></label>
    <label class="col-sm">Đến ngày<input class="form-control" type="date" name="through" value="@Model.Through.ToString("yyyy-MM-dd")" required /></label>
    <label class="col-sm">Loại báo cáo
        <select class="form-select" name="section">
            <option value="Overview" selected="@(section == ReportSection.Overview)">Tổng quan</option>
            <option value="Revenue" selected="@(section == ReportSection.Revenue)">Doanh thu</option>
            <option value="Orders" selected="@(section == ReportSection.Orders)">Đơn hàng</option>
            <option value="TopBooks" selected="@(section == ReportSection.TopBooks)">Sách bán chạy</option>
            <option value="Inventory" selected="@(section == ReportSection.Inventory)">Tồn kho</option>
        </select>
    </label>
    <div class="col-sm-auto d-flex gap-2">
        <button class="btn btn-primary">Xem báo cáo</button>
        <button class="btn btn-outline-primary" type="submit" asp-action="Export">Xuất Excel</button>
    </div>
</form>

@if (report is null)
{
    return;
}

@if (section is ReportSection.Overview or ReportSection.Revenue)
{
    <section class="surface p-4 mb-4">
        <h2 class="h4">Doanh thu từ đơn hoàn tất</h2>
        @if (report.Revenue.Count == 0)
        {
            <p class="text-secondary">Chưa có đơn hoàn tất trong khoảng chọn.</p>
        }
        else
        {
            var max = report.Revenue.Max(day => day.Revenue);
            <p>Tổng trong kỳ <strong>@report.Revenue.Sum(day => day.Revenue).ToString("N0") ₫</strong></p>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Ngày</th><th>Đơn hoàn tất</th><th>Doanh thu</th></tr></thead>
                    <tbody>
                    @foreach (var day in report.Revenue)
                    {
                        <tr><td>@day.Day</td><td>@day.CompletedOrders</td><td>
                            @day.Revenue.ToString("N0") ₫
                            <progress class="d-block" aria-label="Doanh thu @day.Day" max="@Math.Max(1, max)" value="@day.Revenue"></progress>
                        </td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
@if (section is ReportSection.Overview or ReportSection.Orders)
{
    <section class="surface p-4 mb-4">
        <h2 class="h4">Đơn hàng theo ngày tạo</h2>
        @if (report.Orders.Count == 0)
        {
            <p class="text-secondary">Chưa có đơn trong khoảng chọn.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Trạng thái</th><th>Số đơn</th></tr></thead>
                    <tbody>
                    @foreach (var order in report.Orders)
                    {
                        <tr><td>@ReportsViewModel.Status(order.Status)</td><td>@order.Count</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
@if (section is ReportSection.Overview or ReportSection.TopBooks)
{
    <section class="surface p-4 mb-4">
        <h2 class="h4">Sách bán chạy</h2>
        @if (report.TopBooks.Count == 0)
        {
            <p class="text-secondary">Chưa có dữ liệu bán trong khoảng chọn.</p>
        }
        else
        {
            var max = report.TopBooks.Max(book => book.Quantity);
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Sách</th><th>Số cuốn trong đơn hoàn tất</th></tr></thead>
                    <tbody>
                    @foreach (var book in report.TopBooks)
                    {
                        <tr><td>@book.Title</td><td>
                            @book.Quantity
                            <progress class="d-block" aria-label="Số lượng @book.Title" max="@Math.Max(1, max)" value="@book.Quantity"></progress>
                        </td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
@if (section is ReportSection.Overview or ReportSection.Inventory)
{
    <section class="surface p-4 mb-4">
        <h2 class="h4">Nhập và tồn kho</h2>
        <p>Trong kỳ đã nhập <strong>@report.ReceivedQuantity cuốn</strong> với giá trị @report.ReceivingCost.ToString("N0") ₫ theo đơn giá trên phiếu.</p>
        <h3 class="h6">Tồn hiện tại</h3>
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Sách</th><th>Tồn</th><th>Ngưỡng</th><th>Cảnh báo</th></tr></thead>
                <tbody>
                @foreach (var book in report.Inventory)
                {
                    <tr><td>@book.Title</td><td>@book.Stock</td><td>@book.Minimum</td><td>@(book.Stock < book.Minimum ? "Sắp hết" : "Đủ tồn")</td></tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
