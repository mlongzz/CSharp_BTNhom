@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}
<div class="page-heading">
    <div>
        <p class="eyebrow mb-1">TÀI KHOẢN KHÁCH HÀNG</p>
        <h1>Lịch sử đơn hàng</h1>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Tiếp tục mua sách</a>
</div>
@if (Model.Count == 0)
{
    <p>Chưa có đơn hàng.</p>
}
@foreach (var order in Model)
{
    <partial name="_OrderCard" model="order" />
}
